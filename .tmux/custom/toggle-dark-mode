#!/usr/bin/env bash
#
# Switch the tmux colors between Solarized dark and light.
#
# Usage: toggle-dark-mode             toggle (prefix T)
#        toggle-dark-mode dark|light  set (follow-system-theme)
#
set -euo pipefail

status_style_dark="fg=#93a1a1,bg=default"
window_status_dark="#[fg=#002b36, bg=colour27]#[fg=colour255, bg=colour27] #I: #W #[fg=colour27, bg=#002b36]"

status_style_light="fg=#586e75,bg=default"
window_status_light="#[fg=#fdf6e3, bg=colour27]#[fg=colour7, bg=colour27] #I: #W #[fg=colour27, bg=#fdf6e3]"

dark() {
    tmux set -g status-style "$status_style_dark"
    tmux set -g window-status-current-format "$window_status_dark"
    tmux set -g pane-active-border-style fg=green
    # tmux-flash reads it for its colors.
    tmux set -g @color-mode dark
}

light() {
    tmux set -g status-style "$status_style_light"
    tmux set -g window-status-current-format "$window_status_light"
    tmux set -g pane-active-border-style fg=red
    tmux set -g @color-mode light
}

case "${1:-}" in
    dark)  dark ;;
    light) light ;;
    "")
        # From the light style to dark; from any other style to light.
        if [[ "$(tmux show -Av status-style)" == "$status_style_light" ]]; then
            echo "enable dark mode"
            dark
        else
            echo "enable light mode"
            light
        fi
        ;;
    *)
        echo "usage: toggle-dark-mode [dark|light]" >&2
        exit 1
        ;;
esac
