# sway config: the i3 config (~/.config/i3/config) for the Wayland session.
# Bindings and window behaviour are the same; see sway(5).
#
# Bone 2 keys: b n r s = left down up right.

# Solarized. ~/bin/theme switches dark and light: it writes the base colors
# into ~/.config/sway.d/theme.conf for the next login and sets them in the
# running session. Use the colors only in top-level lines (not in blocks,
# not in exec lines): theme runs those lines again. The defaults below are
# the dark palette.

set $yellow     #b58900
set $orange     #cb4b16
set $red        #dc322f
set $magenta    #d33682
set $violet     #6c71c4
set $blue       #268bd2
set $cyan       #2aa198
set $green      #859900

set $baseA3 #002b36
set $baseA2 #073642
set $baseA1 #586e75
set $baseA0 #657b83
set $baseB0 #839496
set $baseB1 #93a1a1
set $baseB2 #eee8d5
set $baseB3 #fdf6e3
set $custom #1c5766

# Keyboards. Left modifiers as on macOS with Cmd and Ctrl swapped (in X,
# xremap does it): the Alt key next to Space gives Control, the Ctrl key in
# the corner Alt. Right Alt stays the bone2 level key. Repeat: 180 ms
# delay, 30/s, as in X (xorg-conf/50-keyboard-repeat.conf). ~/bin/kb
# changes the layout and writes it into ~/.config/sway.d/kb.conf, so a
# reload keeps it: this block must come before the include below.
input type:keyboard {
    xkb_layout de
    xkb_options ctrl:swap_lalt_lctl
    repeat_delay 180
    repeat_rate 30
}

# Touchpads as in X (xorg-conf/40-touchpad.conf): click by pressing the pad,
# no tapping (`~/bin/touchpad tap` turns it on for the session), no
# tap-and-drag, two- and three-finger clicks anywhere on the pad.
#
# Acceleration: the libinput custom curve of X (xorg-conf/40-touchpad.conf,
# same step and points; test/touchpad/test.sh): macOS's trackpad curve at
# tracking speed 0.6875, converted to this laptop (see the X file).
# sway 1.12 has only adaptive|flat (swaywm/sway#8488); the sway that
# bootstrap.sh builds from a fork with pull request #8592 has custom.
# Fedora's sway, which sway-session starts when that build does not
# load, rejects both lines (swaynag) and keeps libinput's default.
# pointer_accel does not apply to a custom curve. Try others live:
#   swaymsg input type:touchpad pointer_accel_custom 0.5 0.0 0.6 2.0 ...
#   swaymsg input type:touchpad scroll_factor 0.4
input type:touchpad {
    tap disabled
    drag disabled
    click_method clickfinger
    accel_profile custom
    pointer_accel_custom 0.5 0.0 0.432 1.336 2.717 4.582 6.825 9.095 11.364 13.633 15.903 18.172 20.441 22.591 24.553 26.369 28.068 29.670 31.190 32.639 34.027 35.360 36.644 37.886 39.087 40.253 41.386 42.489 43.564 44.613 45.638 46.640 47.621 48.583
    # Chromium/Electron (Proton Mail) and terminals scrolled too fast at
    # 0.5; Firefox makes up for it with mousewheel.default.delta_multiplier_y
    # 500 in about:config.
    scroll_factor 0.1
}

# Mice: 15 % slower than libinput's adaptive curve at pointer_accel -0.27
# (2026-11-20), at every speed. On a mouse pointer_accel moves only the
# acceleration threshold and the maximum, not slow movements, so this is
# a custom curve: 0.85 times the adaptive mouse profile of libinput 1.32
# (src/filter-mouse.c): factor 10 v + 0.3 below 0.07 units/ms, 1 up to the
# threshold 0.4675, then 0.8975 (v - 0.4675) + 1 up to 1.595. Points are
# output speeds for v = 0, 0.025, ... 1.575 units/ms; libinput continues
# the last (linear) segment. The custom curve gets raw device units, the
# adaptive one 1000 dpi units: the same for mice without a MOUSE_DPI in
# udev's hwdb (the MX Vertical has none); a mouse with one moves at its
# real resolution. Same derivation for X: xorg-conf/45-mouse.conf.
# Checked by test/mouse-accel/test.sh. The TrackPoint block below keeps
# the adaptive profile.
input type:pointer {
    accel_profile custom
    pointer_accel_custom 0.025 0.0 0.0117 0.034 0.0638 0.085 0.1062 0.1275 0.1488 0.17 0.1913 0.2125 0.2338 0.255 0.2762 0.2975 0.3187 0.34 0.3613 0.3825 0.4065 0.4374 0.4693 0.5021 0.5359 0.5706 0.6063 0.643 0.6806 0.7192 0.7587 0.7991 0.8406 0.8829 0.9263 0.9705 1.0158 1.0619 1.1091 1.1572 1.2062 1.2562 1.3072 1.3591 1.412 1.4658 1.5205 1.5591 1.593 1.6269 1.6608 1.6947 1.7286 1.7625 1.7964 1.8303 1.8642 1.8981 1.9319 1.9658 1.9997 2.0336 2.0675 2.1014 2.1353
    scroll_factor 0.5
}

# The ThinkPad's TrackPoint: adaptive, -0.36 (factor 0.374; -0.27 was 25%
# slower than the earlier -0.17: libinput multiplies the TrackPoint's whole
# curve by a factor of the speed, 0.495 against 0.660). sway has no
# TrackPoint type: settings by identifier win over the type:pointer block.
input "2:10:TPPS/2_Elan_TrackPoint" {
    accel_profile adaptive
    pointer_accel -0.36
}

# X11 programs (VMware) run on xwayland-satellite, which ~/bin/sway-autostart
# starts: it gives them the output's pixels. sway's own Xwayland draws them
# at scale 1 and sway scales them up, which is blurry at scale 1.5.
# To use sway's Xwayland again: put a # before the next line, then log out
# and in again (sway reads it only at start).
xwayland disable

# Machine-local settings, not in the repository: output.conf (bootstrap.sh,
# the display scale), theme.conf (~/bin/theme) and kb.conf (~/bin/kb).
# Variables set there replace the defaults above for all lines below.
include ~/.config/sway.d/*.conf

output * bg $baseA2 solid_color

# class                     border  bg      text    indicator
client.focused              $green  $green  $baseB3 $blue
client.focused_inactive     $custom $custom $baseB2 $violet
client.unfocused            $baseA2 $baseA2 $baseB1 $baseA1
client.urgent               $yellow $yellow $baseB3 $orange

# Win key.
set $mod Mod4

# Font for window titles; swaybar uses it too unless its bar block sets one.
font pango:Menlo 10

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod normal

# start a terminal (Alacritty or wezterm: `term --use`; a process of its own per window: ~/bin/term)
bindsym $mod+Return exec ~/bin/term

# Increase screen brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5% && pkill -USR1 -x i3status
# Decrease screen brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- && pkill -USR1 -x i3status
# Volume control
bindsym XF86AudioLowerVolume exec amixer set Master 5%-
bindsym XF86AudioRaiseVolume exec amixer set Master 5%+
bindsym XF86AudioMute exec amixer set Master toggle
# Mute the selected microphone (Capture is the default source via PipeWire)
bindsym XF86AudioMicMute exec amixer set Capture toggle

# Media players (MPRIS: browsers, Spotify, mpv) through playerctl.
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Screenshot to ~/Pictures/Screenshots and the clipboard: the screen, or an
# area chosen with the mouse (Escape cancels).
bindsym Print exec ~/bin/screenshot
bindsym Shift+Print exec ~/bin/screenshot --area

# Lock the screen.
bindsym $mod+Escape exec ~/bin/pwr lock
# Monitor layout; ~/bin/kanshi-save NAME keeps it for these monitors.
bindsym XF86Display exec wdisplays

# kill focused window
bindsym $mod+Shift+j kill

# program launcher (desktop entries)
bindsym $mod+i exec fuzzel

# change focus
bindsym $mod+b focus left
bindsym $mod+n focus down
bindsym $mod+r focus up
bindsym $mod+s focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Focus a window by its label, like tmux prefix q. The hint colors are the
# window title colors; `theme` runs this line again, so they follow dark
# and light. Labels and font: ~/.config/sway-easyfocus/config.yaml. Every
# key exits. Options as --name=$color, without quotes: swaymsg (theme)
# strips the quotes of bindsym arguments, and a # at the start of a shell
# word starts a comment.
bindsym $mod+g exec sway-easyfocus --label-background-color=$baseA2 --label-text-color=$baseB1 \
    --focused-background-color=$green --focused-text-color=$baseB3 focus

# move focused window
bindsym $mod+Shift+b move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+r move up
bindsym $mod+Shift+s move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# move the focused workspace to the screen left / down / up / right
bindsym $mod+Ctrl+b move workspace to output left
bindsym $mod+Ctrl+n move workspace to output down
bindsym $mod+Ctrl+r move workspace to output up
bindsym $mod+Ctrl+s move workspace to output right
bindsym $mod+Ctrl+Left move workspace to output left
bindsym $mod+Ctrl+Down move workspace to output down
bindsym $mod+Ctrl+Up move workspace to output up
bindsym $mod+Ctrl+Right move workspace to output right

# focus the screen left / right ($mod+Mod1: physical Super+Ctrl, Alt and
# Ctrl are swapped)
bindsym $mod+Mod1+b focus output left
bindsym $mod+Mod1+s focus output right

# swap two windows: mark one ($mod+m again unmarks; the title shows
# [swap], which sway hides for marks starting with "_"), focus the other,
# then swap them
bindsym $mod+m mark --toggle swap
bindsym $mod+Shift+m swap container with mark swap; unmark swap

# swaytiles (user unit swaytiles.service): a tiling layout per workspace,
# only where one is picked; other workspaces keep sway's own. $mod+t picks
# the layout of the focused workspace in fuzzel; $mod+Shift+Return swaps
# the focused window with the master (a nop the daemon reads from the
# binding event; without the daemon it does nothing). It runs with
# --no-keys: the move, kill and float keys stay sway's own.
bindsym $mod+t exec swaytiles menu --launcher fuzzel
bindsym $mod+Shift+Return nop layout master

# split in horizontal orientation
bindsym $mod+v split h

# split in vertical orientation
bindsym $mod+f split v

# enter fullscreen mode for the focused container
bindsym $mod+z fullscreen

# change container layout (tabbed, toggle split); no stacking binding: it
# was easy to hit by accident
bindsym $mod+d layout tabbed
bindsym $mod+u layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# Window rules: app_id for Wayland clients and for X11 clients on
# xwayland-satellite (it sets the WM_CLASS class as app_id), class or
# instance for X11 clients on sway's Xwayland.

# nmrs-gui (network settings); a click on the bar's network block opens it.
for_window [app_id="^nmrs$"] floating enable
for_window [class="^nmrs$"] floating enable
# blueman (Bluetooth): its windows have the program name as app_id or
# WM_CLASS instance (blueman-manager, blueman-services, ...).
for_window [app_id="^blueman-"] floating enable
for_window [instance="^blueman-"] floating enable

# Clipboard history (cliphist) in fuzzel.
bindsym $mod+c exec ~/bin/clip-pick

# Monitor layout.
for_window [app_id="^wdisplays$"] floating enable

# Audio devices and per-app streams; opened from the bar's volume block.
for_window [app_id="^org\.pulseaudio\.pavucontrol$"] floating enable
for_window [instance="^pavucontrol$"] floating enable

# LANDrop (file transfer on the LAN; AppImage in ~/Applications, Electron):
# on Wayland Electron's app_id is its program or product name
# (landrop-v2-electron, LANDrop), on X the WM_CLASS class is "LANDrop".
for_window [app_id="(?i)^landrop"] floating enable
for_window [class="^LANDrop$"] floating enable

# install4j installers (JDownloader 2's JDownloader2Setup_unix_nojre.sh):
# a fixed-size wizard that Java draws at its own size, cut off (no Cancel,
# Next half hidden) when tiled. X11 (Java falls back from Wayland), WM_CLASS
# class "install4j-Installer<number>", the number new per run:
# xwayland-satellite gives it as app_id, sway's Xwayland as class.
for_window [app_id="^install4j-"] floating enable
for_window [class="^install4j-"] floating enable

# 1Password (Electron): its desktop file's StartupWMClass is
# com.onepassword.OnePassword, older versions use 1Password. On Wayland the
# app_id, on X11 the class (xwayland-satellite makes it the app_id).
for_window [app_id="(?i)^(com\.onepassword\.|1password)"] floating enable
for_window [class="(?i)^(com\.onepassword\.|1password)"] floating enable

# Thunar (GTK 3): app_id Thunar on Wayland, class Thunar on X11.
for_window [app_id="^Thunar$"] floating enable
for_window [class="^Thunar$"] floating enable

# No idle lock or suspend while a window is full screen (video).
for_window [all] inhibit_idle fullscreen

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+h focus parent

# focus the child container
bindsym $mod+l focus child

# switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# reload the configuration file
bindsym $mod+Shift+w reload
# i3 restarts in place on this key; sway has no restart, and a reload
# applies config changes too.
bindsym $mod+Shift+a reload
# exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+u exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'systemctl --user stop sway-session.target; swaymsg exit'
# Exit at once, as Ctrl+Alt+Backspace (terminate:ctrl_alt_bksp) in X.
bindsym Ctrl+Alt+BackSpace exec systemctl --user stop sway-session.target; exit

# scratchpad
bindsym $mod+Shift+k move scratchpad
bindsym $mod+k scratchpad show

# Back to the previous workspace.
bindsym $mod+Tab workspace back_and_forth

# Go to a workspace by name or number, from a menu of them (ws-pick:
# fuzzel in sway, dmenu in X); rename the focused one (a number moves it
# there, with its windows).
bindsym $mod+e exec ~/bin/ws-pick
bindsym $mod+Shift+e exec ~/bin/ws-pick --rename


# Previous / next workspace of this screen (left / right in the bar).
bindsym $mod+comma workspace prev_on_output
bindsym $mod+period workspace next_on_output

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym b resize shrink width 10 px or 10 ppt
        bindsym n resize grow height 10 px or 10 ppt
        bindsym r resize shrink height 10 px or 10 ppt
        bindsym s resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # Shift: larger steps.
        bindsym Shift+b resize shrink width 50 px or 25 ppt
        bindsym Shift+n resize grow height 50 px or 25 ppt
        bindsym Shift+r resize shrink height 50 px or 25 ppt
        bindsym Shift+s resize grow width 50 px or 25 ppt
        bindsym Shift+Left resize shrink width 50 px or 25 ppt
        bindsym Shift+Down resize grow height 50 px or 25 ppt
        bindsym Shift+Up resize shrink height 50 px or 25 ppt
        bindsym Shift+Right resize grow width 50 px or 25 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+a mode "resize"

# Workspace mode: $mod+w, then the home-row key below a digit goes to
# that workspace (c t i e o | b n r s g = 1 ... 5 | 6 ... 0, the finger of
# $mod+digit one row down); with Shift it moves the window there. Each ends
# the mode, as do Return, Escape and $mod+w. The mode's name, shown in the
# bar while it is on, is the key map.
mode "1c 2t 3i 4e 5o 6b 7n 8r 9s 0g" {
        bindsym c workspace number 1; mode "default"
        bindsym t workspace number 2; mode "default"
        bindsym i workspace number 3; mode "default"
        bindsym e workspace number 4; mode "default"
        bindsym o workspace number 5; mode "default"
        bindsym b workspace number 6; mode "default"
        bindsym n workspace number 7; mode "default"
        bindsym r workspace number 8; mode "default"
        bindsym s workspace number 9; mode "default"
        bindsym g workspace number 10; mode "default"

        bindsym Shift+c move container to workspace number 1; mode "default"
        bindsym Shift+t move container to workspace number 2; mode "default"
        bindsym Shift+i move container to workspace number 3; mode "default"
        bindsym Shift+e move container to workspace number 4; mode "default"
        bindsym Shift+o move container to workspace number 5; mode "default"
        bindsym Shift+b move container to workspace number 6; mode "default"
        bindsym Shift+n move container to workspace number 7; mode "default"
        bindsym Shift+r move container to workspace number 8; mode "default"
        bindsym Shift+s move container to workspace number 9; mode "default"
        bindsym Shift+g move container to workspace number 10; mode "default"

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+w mode "default"
}

bindsym $mod+w mode "1c 2t 3i 4e 5o 6b 7n 8r 9s 0g"

# The programs of the session (the bar, idle, clipboard history, ...); sway
# runs it once, not on reload.
exec ~/bin/sway-autostart

# A reload (sway 1.12) drops runtime output and input settings: apply
# kanshi's monitor layout and the session's touchpad tap choice again. At
# login kanshi is not running yet, so kanshictl fails there; harmless.
exec_always sh -c 'kanshictl reload; ~/bin/touchpad restore'

# Status bar: eww (~/bin/bar, started by ~/bin/sway-autostart). Where
# bootstrap.sh could not install eww it links swaybar.conf (swaybar with
# i3status-kb) into ~/.config/sway-bar.d. Variables set above reach the
# included file.
include ~/.config/sway-bar.d/*.conf
