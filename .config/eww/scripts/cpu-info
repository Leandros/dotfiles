#!/usr/bin/env bash
#
# cpu-info - details for the CPU popup of the eww bar, as one JSON object:
#   load   1, 5 and 15 minutes (the kernel keeps no 30-minute average),
#          [{"v": "0.84", "lvl": ""}, ...]
#   cores  [{"n": 0, "pct": 12, "type": "p", "lvl": ""}, ...]; type p
#          (performance), e (efficiency) or lp (low-power efficiency) from
#          the hybrid PMUs' cpu lists, p on CPUs without them
#   temps  [{"name": "CPU Package", "v": "61", "lvl": ""}, ...] (°C), one
#          row per sensor present: CPU package, the ThinkPad embedded
#          controller's CPU and GPU, SSD, RAM, Wi-Fi; each value as read
#          (not averaged), several of a kind (RAM modules) "41 / 44";
#          "off" for a sensor that cannot be read (the GPU asleep)
#   fans   ThinkPad fan speeds, {"v": "2516 / 2400", "lvl": ""} (rpm); v
#          empty elsewhere
#   procs  the 15 processes with the most CPU,
#          [{"name", "cpu": "2.6" (percent of one core, as top), "mem":
#          "12.1M" (resident), "lvl"}, ...]
# lvl is "", "mid" (the bar draws it yellow) or "high" (red).
#
# The eww bar runs it only while the block is hovered, every 2 s. The
# kernel counts CPU time only as totals (since boot, since a process
# started), so usage is the change between two samples of /proc/stat and
# /proc/<pid>/stat: each run saves its sample in STATE and compares with
# the one the last run saved (the last 2 s, as top). Without one from 1 to
# MAX_AGE_S seconds ago (the first poll of a hover) it takes two, SAMPLE_S
# apart.
#
set -euo pipefail

readonly PROC="${CPU_INFO_PROC:-/proc}" SYSFS="${CPU_INFO_SYSFS:-/sys}"
readonly SAMPLE_S="${CPU_INFO_SAMPLE_S:-0.5}" TOP_PROCS=15 MAX_AGE_S=5
readonly STATE="${CPU_INFO_STATE:-${XDG_RUNTIME_DIR:-/tmp}/eww-cpu-info.sample}"
# This run's sample and, without a saved one, the first of its two.
readonly NEW="$STATE.$$" FIRST="$STATE.$$.first"
trap 'rm -f "$NEW" "$FIRST"' EXIT
# Yellow from, red from.
readonly CORE_MID=50 CORE_HIGH=80 FAN_MID=4000 FAN_HIGH=5500
# Temperatures (°C) by kind: the CPU throttles at 100, NVIDIA laptop GPUs
# at about 87, NVMe drives warn at about 70, DDR5 throttles at 85.
readonly TEMP_LEVELS='{"cpu": [80, 95], "gpu": [75, 87], "ssd": [60, 70], "ram": [70, 85], "wifi": [70, 90]}'
readonly PROC_MID=50 PROC_HIGH=90
# Load per core.
readonly LOAD_MID=0.7 LOAD_HIGH=1

# /proc/stat, then a stat line per process, in one process (it runs every
# 2 s while the popup is open). A process can end between the glob and the
# read.
sample() { cat "$PROC/stat" "$PROC"/[0-9]*/stat 2>/dev/null || true; }

# Cpu list of a hybrid PMU ("0-5"), empty without one. Reads with
# builtins here and below: no process per file.
cpus_of() {
    local list=""
    [[ -r "$SYSFS/devices/$1/cpus" ]] && read -r list < "$SYSFS/devices/$1/cpus"
    echo "$list"
}

# "core N percent type" per core and "proc cpu-percent cpu-text mem name"
# for the TOP_PROCS processes with the most CPU of those in both samples,
# tab-separated.
# A sample file: "@ <epoch seconds>" (awk skips it), then sample's lines.
save_sample() { { echo "@ $EPOCHSECONDS"; sample; } > "$1"; }

usage() {
    local before="$STATE" _ at=0
    [[ -r "$STATE" ]] && read -r _ at < "$STATE"
    if ((EPOCHSECONDS - at < 1 || EPOCHSECONDS - at > MAX_AGE_S)); then
        save_sample "$FIRST"
        sleep "$SAMPLE_S"
        before="$FIRST"
    fi
    save_sample "$NEW"
    awk -v e="$(cpus_of cpu_atom)" -v lp="$(cpus_of cpu_lowpower)" \
        -v page="$(getconf PAGESIZE)" -v top="$TOP_PROCS" '
        function add_cpus(list, type,   parts, n, i, r) {
            n = split(list, parts, ",")
            for (i = 1; i <= n; i++) {
                if (split(parts[i], r, "-") == 1) r[2] = r[1]
                for (c = r[1]; c <= r[2]; c++) types[c] = type
            }
        }
        function size(b) {
            if (b >= 1073741824) return sprintf("%.1fG", b / 1073741824)
            if (b >= 1048576) return sprintf("%.1fM", b / 1048576)
            if (b >= 1024) return sprintf("%.1fK", b / 1024)
            return b "B"
        }
        # comm is in parentheses and may hold spaces and ")": up to the last.
        function parse(line,   op, cl, k, f) {
            op = index(line, "(")
            cl = 0
            while ((k = index(substr(line, cl + 1), ")")) > 0) cl += k
            name = substr(line, op + 1, cl - op - 1)
            split(substr(line, cl + 2), f, " ")
            ticks = f[12] + f[13]
            rss = f[22]
        }
        BEGIN { add_cpus(e, "e"); add_cpus(lp, "lp"); FS = " " }
        /^cpu[0-9]/ {
            n = substr($1, 4) + 0
            total = 0
            for (i = 2; i <= NF; i++) total += $i
            busy = total - $5 - $6
            if (FNR == NR) { cbusy[n] = busy; ctotal[n] = total; next }
            dt = total - ctotal[n]
            elapsed += dt
            ncores++
            pct[n] = dt > 0 ? int(100 * (busy - cbusy[n]) / dt + 0.5) : 0
            next
        }
        /^[0-9]/ {
            parse($0)
            if (FNR == NR) { pticks[$1] = ticks; next }
            if (!($1 in pticks)) next
            pname[$1] = name; pdelta[$1] = ticks - pticks[$1]; prss[$1] = rss
        }
        END {
            for (n = 0; n < ncores; n++)
                printf "core\t%d\t%d\t%s\n", n, pct[n], (n in types ? types[n] : "p")
            # Ticks of one core in the sample time.
            per_core = ncores ? elapsed / ncores : 0
            # The top ones by repeated maximum: no sort process.
            for (i = 0; i < top; i++) {
                best = ""
                for (p in pdelta) if (best == "" || pdelta[p] > pdelta[best]) best = p
                if (best == "") break
                c = per_core > 0 ? 100 * pdelta[best] / per_core : 0
                printf "proc\t%s\t%.1f\t%s\t%s\n", c, c, size(prss[best] * page), pname[best]
                delete pdelta[best]
            }
        }' "$before" "$NEW"
    # Renamed: another bar's run (one per display) reads a whole file.
    mv -f "$NEW" "$STATE"
}

# The °C of an hwmon temp*_input, "off" where it cannot be read: the
# ThinkPad's GPU sensor while the NVIDIA GPU sleeps (runtime D3), Wi-Fi
# while the card is off.
celsius() {
    local value
    if read -r value < "$1" 2>/dev/null; then echo "$((value / 1000))"; else echo off; fi
}

# The °C of the sensor of hwmon $1 labelled $2 or $3; fails without one.
labelled() {
    local label name
    for label in "$1"/temp*_label; do
        name=""
        [[ -r "$label" ]] && read -r name < "$label"
        if [[ "$name" == "$2" || "$name" == "${3-$2}" ]]; then
            celsius "${label%_label}_input"
            return
        fi
    done
    return 1
}

# "name<TAB>°C[ / °C ...]<TAB>kind" per sensor present, in a fixed order:
# CPU package (coretemp "Package id 0", k10temp Tctl, else the
# x86_pkg_temp thermal zone), thinkpad_acpi's CPU and GPU, SSDs (nvme
# Composite), RAM modules (spd5118), Wi-Fi (iwlwifi).
temps() {
    local hw name zone v pkg="" cpu="" gpu="" ssd=() ram=() wifi=()
    for hw in "$SYSFS"/class/hwmon/hwmon*; do
        name=""
        [[ -r "$hw/name" ]] && read -r name < "$hw/name"
        case "$name" in
            coretemp|k10temp) v="$(labelled "$hw" "Package id 0" Tctl)" && pkg="$v" ;;
            thinkpad)
                v="$(labelled "$hw" CPU)" && cpu="$v"
                v="$(labelled "$hw" GPU)" && gpu="$v"
                ;;
            nvme) v="$(labelled "$hw" Composite)" && ssd+=("$v") ;;
            spd5118) v="$(celsius "$hw/temp1_input")" && ram+=("$v") ;;
            iwlwifi*) v="$(celsius "$hw/temp1_input")" && wifi+=("$v") ;;
        esac
    done
    if [[ -z "$pkg" ]]; then
        for zone in "$SYSFS"/class/thermal/thermal_zone*; do
            name=""
            [[ -r "$zone/type" ]] && read -r name < "$zone/type"
            [[ "$name" == x86_pkg_temp ]] && v="$(celsius "$zone/temp")" && pkg="$v" && break
        done
    fi
    row "CPU Package" cpu "$pkg"
    row "CPU (ThinkPad)" cpu "$cpu"
    row "GPU (ThinkPad)" gpu "$gpu"
    row SSD ssd ${ssd[@]+"${ssd[@]}"}
    row RAM ram ${ram[@]+"${ram[@]}"}
    row Wi-Fi wifi ${wifi[@]+"${wifi[@]}"}
}

# One temps line: name, kind, the values (none or empty: no line).
row() {
    local name="$1" kind="$2" IFS=/
    shift 2
    [[ $# -gt 0 && -n "$1" ]] || return 0
    local joined="$*"
    printf '%s\t%s\t%s\n' "$name" "${joined//\//' / '}" "$kind"
}

# Fan speeds of thinkpad_acpi's hwmon (~/bin/fan sets the level), one per
# line; nothing elsewhere.
fans() {
    local hw input name rpm
    for hw in "$SYSFS"/class/hwmon/hwmon*; do
        name=""
        [[ -r "$hw/name" ]] && read -r name < "$hw/name"
        [[ "$name" == thinkpad ]] || continue
        for input in "$hw"/fan*_input; do
            [[ -r "$input" ]] && read -r rpm < "$input" && echo "$rpm"
        done
    done
    return 0
}

main() {
    local load
    read -r -a load < "$PROC/loadavg"
    usage | jq -R -s -c \
        --arg loads "${load[*]:0:3}" --arg temps "$(temps)" --arg fans "$(fans)" \
        --argjson core_lvl "[$CORE_MID, $CORE_HIGH]" --argjson temp_lvl "$TEMP_LEVELS" \
        --argjson fan_lvl "[$FAN_MID, $FAN_HIGH]" --argjson proc_lvl "[$PROC_MID, $PROC_HIGH]" \
        --argjson load_lvl "[$LOAD_MID, $LOAD_HIGH]" '
        def lvl($t): if . >= $t[1] then "high" elif . >= $t[0] then "mid" else "" end;
        [split("\n")[] | select(length > 0) | split("\t")] as $rows
        | [$rows[] | select(.[0] == "core")
           | {n: (.[1] | tonumber), pct: (.[2] | tonumber), type: .[3]}
           | . + {lvl: (.pct | lvl($core_lvl))}] as $cores
        | ($cores | length) as $ncores
        | {
            load: [$loads | split(" ")[] | {v: ., lvl: (tonumber | lvl($load_lvl | map(. * $ncores)))}],
            cores: $cores,
            temps: [$temps | split("\n")[] | select(length > 0) | split("\t")
                    | . as $r
                    | {name: $r[0], v: $r[1],
                       lvl: ([$r[1] | split(" / ")[] | tonumber?] | max // 0 | lvl($temp_lvl[$r[2]]))}],
            fans: ($fans | split("\n") | map(select(length > 0))
                   | {v: join(" / "), lvl: (map(tonumber) | max // 0 | lvl($fan_lvl))}),
            procs: [$rows[] | select(.[0] == "proc")
                    | {sort: (.[1] | tonumber), name: .[4], cpu: .[2], mem: .[3]}]
                   | sort_by(-.sort)
                   | map({name, cpu, mem, lvl: (.sort | lvl($proc_lvl))})
          }'
}

main "$@"
