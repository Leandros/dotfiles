#!/usr/bin/env bash
#
# i3-workspaces - i3's workspaces as a JSON array, again on every change.
#
# For the eww bar: num, name, focused, visible, urgent and output of each
# workspace, as `i3-msg -t get_workspaces` prints them on one line.
# Connects again after an i3 restart; ends with the X session.
#
set -euo pipefail

readonly RETRY_S="${I3_WORKSPACES_RETRY_S:-1}"

while xset q >/dev/null 2>&1; do
    if i3-msg -t get_workspaces 2>/dev/null; then
        i3-msg -t subscribe -m '["workspace","output"]' 2>/dev/null | while read -r _; do
            i3-msg -t get_workspaces
        done
    fi
    sleep "$RETRY_S"
done
