#!/usr/bin/env bash
#
# block-tooltips BLOCK - hover text of the battery, volume or vpn block,
# empty without details. The network blocks have net-info. The eww bar
# runs it only while that block is hovered, for that block alone (each
# block asks other programs: upower, pactl, tailscale).
#
set -euo pipefail

readonly TIMEOUT_S=2
readonly SYSFS="${BLOCK_TOOLTIPS_SYSFS:-/sys}"

battery_tooltip() {
    local bat
    bat="$(upower -e 2>/dev/null | grep -m 1 battery_)" || return 0
    upower -i "$bat" | awk -F': *' '
        /^ +state:/          { print "State:    " $2 }
        /^ +energy-rate:/    { print "Power:    " $2 }
        /^ +time to (empty|full):/ { sub(/^ +/, "", $1); print "Time to " substr($1, 9) ": " $2 }
        /^ +capacity:/       { print "Health:   " $2 }'
    # The charge limit ~/bin/charge sets.
    local limit
    for limit in "$SYSFS"/class/power_supply/BAT*/charge_control_end_threshold; do
        [[ -r "$limit" ]] && printf 'Limit:    %s%%\n' "$(< "$limit")"
        break
    done
}

vpn_tooltip() {
    command -v tailscale >/dev/null || return 0
    local ips
    ips="$(timeout "$TIMEOUT_S" tailscale ip 2>/dev/null | paste -sd ' ')" || return 0
    [[ -n "$ips" ]] && printf 'Tailscale: %s\n' "$ips"
}

# The default output device (sink), by its description.
volume_tooltip() {
    command -v pactl >/dev/null || return 0
    local sink
    sink="$(timeout "$TIMEOUT_S" pactl get-default-sink 2>/dev/null)" || return 0
    timeout "$TIMEOUT_S" pactl list sinks 2>/dev/null | awk -v sink="$sink" '
        /^\tName: / { this = substr($0, 8) }
        /^\tDescription: / && this == sink { print "Output: " substr($0, 15); exit }' || true
}

main() {
    case "${1:-}" in
        battery) battery_tooltip ;;
        volume) volume_tooltip ;;
        vpn) vpn_tooltip ;;
        *) echo "usage: block-tooltips battery|volume|vpn" >&2; exit 2 ;;
    esac
}

main "$@"
