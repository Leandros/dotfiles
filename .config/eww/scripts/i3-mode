#!/usr/bin/env bash
#
# i3-mode - i3's binding mode (resize), one line per change.
#
# For the eww bar, as i3bar's mode indicator: the mode name, empty for
# "default". Connects again after an i3 restart, starting with the
# current mode; ends with the X session.
#
set -euo pipefail

readonly RETRY_S="${I3_MODE_RETRY_S:-1}"

name() { jq -r --unbuffered "$1 | if . == \"default\" then \"\" else . end"; }

while xset q >/dev/null 2>&1; do
    if i3-msg -t get_binding_state 2>/dev/null | name '.name'; then
        i3-msg -t subscribe -m '["mode"]' 2>/dev/null | name '.change' || true
    fi
    sleep "$RETRY_S"
done
