;; The status bar (eww), in place of i3bar; ~/bin/bar opens one per output.
;; i3bar has no hover; here blocks show details as tooltips.
;;
;; Status blocks come from ~/bin/i3status-kb (scripts/status-blocks), so
;; text and colors are those of i3bar; clicks do what they do there
;; (scripts/block-click).

(deflisten blocks :initial "{}" "scripts/status-blocks")
;; list: the workspaces, each with key, its key in the workspace mode ("" in
;; other modes); keymap: that mode is on (scripts/i3-workspaces).
(deflisten workspaces :initial '{"keymap":false,"list":[]}' "scripts/i3-workspaces")
;; i3's binding mode (resize); empty in the default mode.
(deflisten i3_mode :initial "" "scripts/i3-mode")
(deflisten theme :initial "dark" "scripts/theme-mode")
;; The block under the mouse (onhover). All details below are fetched only
;; while their block is hovered (:run-while); the bar text comes from
;; i3status alone.
(defvar hover "")
(defpoll net_info :interval "2s" :initial "{}" :run-while {hover == "wireless" || hover == "ethernet"} "scripts/net-info")
(defpoll battery_tip :interval "5s" :initial "" :run-while {hover == "battery"} "scripts/block-tooltips battery")
(defpoll volume_tip :interval "5s" :initial "" :run-while {hover == "volume"} "scripts/block-tooltips volume")
(defpoll vpn_tip :interval "5s" :initial "" :run-while {hover == "vpn"} "scripts/block-tooltips vpn")
(defpoll syncthing_info :interval "3s" :initial "" :run-while {hover == "syncthing"} "~/bin/syncthing-status --details")
(defpoll disk_info :interval "10s" :initial "[]" :run-while {hover == "disk_info"} "scripts/disk-info")
(defpoll cpu_info :interval "2s" :initial "{}" :run-while {hover == "cpu_usage"} "scripts/cpu-info")
;; User and system CPU usage for the graph, always: the graph keeps its history.
(deflisten cpu_usage :initial '{"user":0,"system":0}' "scripts/cpu-usage")
(defpoll mem_info :interval "2s" :initial "{}" :run-while {hover == "memory"} "scripts/mem-info")
(defpoll uptime :interval "60s" :initial "" :run-while {hover == "time"} "uptime -p")
(defpoll today :interval "60s" :initial "{}" :run-while {hover == "time"}
  "date '+{\"day\":%-d,\"month\":%-m,\"year\":%Y}'")

;; Workspaces of this output. i3bar: focused, active (visible on another
;; output), urgent, inactive. In the workspace mode each numbered workspace
;; shows its key right after the number ("4e: mail"); 10 has the key of 0.
;; The key comes with the list: eww updates widgets in a `for` only when
;; the list changes, not on another variable (i3_mode).
(defwidget workspace-buttons [output]
  (box :class "workspaces" :space-evenly false :halign "start"
    (for ws in {workspaces.list}
      (button :visible {ws.output == output}
              :class "ws ${ws.focused ? 'focused' : ws.visible ? 'active' : ''} ${ws.urgent ? 'urgent' : ''}"
              :onclick "~/bin/ws-pick --go '${ws.name}'"
        (box :space-evenly false
          (label :text {ws.num >= 0 ? "${ws.num}" : ws.name})
          (label :class "ws-key" :visible {ws.key != ""} :text {ws.key})
          (label :visible {ws.num >= 0 && ws.name != "${ws.num}"}
                 :text {substring(ws.name, strlength("${ws.num}"), strlength(ws.name))}))))))

;; A section title in a line across the popup ("━━ Load Average ━━━━").
(defwidget tip-heading [title ?first]
  (box :class "tip-heading ${first == true ? 'first' : ''}" :space-evenly false :spacing 6
    (box :class "rule" :width 12 :valign "center")
    (label :class "title" :text title)
    (box :class "rule" :hexpand true :valign "center")))

;; Numbers above the norm get class mid (yellow) or high (red); cpu-info
;; decides (lvl).
(defwidget cpu-tip []
  (box :class "info-tip cpu-tip" :orientation "v" :space-evenly false :spacing 4 :width 340
    (tip-heading :title "CPU Usage" :first true)
    ;; Two graphs over each other: user (blue) and system (red). Size set
    ;; here: a graph asks GTK only for its line thickness.
    (overlay
      (graph :class "cpu-graph user" :width 340 :height 60 :min 0 :max 100 :dynamic false
             :time-range "5m" :thickness 2 :line-style "round" :value {cpu_usage.user})
      (graph :class "cpu-graph system" :width 340 :height 60 :min 0 :max 100 :dynamic false
             :time-range "5m" :thickness 2 :line-style "round" :value {cpu_usage.system}))
    (box :class "legend" :space-evenly false :spacing 12 :halign "start"
      (label :class "user" :text "■ user ${cpu_usage.user}%")
      (label :class "system" :text "■ system ${cpu_usage.system}%")
      (label :class "dim" :text "last 5 min"))
    ;; One bar per core, colored by type: performance, efficiency,
    ;; low-power efficiency. Each `for` in a box of its own: eww drew no
    ;; widget after a `for`.
    (box :class "cores" :space-evenly false :spacing 4 :halign "center"
      (for core in {cpu_info?.cores ?: []}
        (box :class "core ${core.type}" :orientation "v" :space-evenly false :spacing 2
          (progress :orientation "v" :flipped true :value {core.pct} :height 60 :halign "center")
          (label :class "pct ${core.lvl}" :text "${core.pct}")
          (label :class "num" :text "${core.n}"))))
    (box :class "legend" :space-evenly false :spacing 12 :halign "center"
      (label :class "p" :text "■ performance")
      (label :class "e" :text "■ efficiency")
      (label :class "lp" :text "■ low-power"))

    (tip-heading :title "Load Average")
    (box :space-evenly false :spacing 6
      (label :class "value ${cpu_info?.load?.[0]?.lvl ?: ''}" :text {cpu_info?.load?.[0]?.v ?: "…"})
      (label :class "dim" :text "/")
      (label :class "value ${cpu_info?.load?.[1]?.lvl ?: ''}" :text {cpu_info?.load?.[1]?.v ?: "…"})
      (label :class "dim" :text "/")
      (label :class "value ${cpu_info?.load?.[2]?.lvl ?: ''}" :text {cpu_info?.load?.[2]?.v ?: "…"})
      (label :class "dim" :hexpand true :xalign 1 :text "1 / 5 / 15 min"))

    (tip-heading :title "Temperature")
    (box :space-evenly false
      (label :class "key" :hexpand true :xalign 0 :text "CPU Temp")
      (label :class "value ${cpu_info?.temp?.lvl ?: ''}" :text "${cpu_info?.temp?.v ?: '…'} °C"))

    ;; ThinkPads only (~/bin/fan).
    (box :orientation "v" :space-evenly false :spacing 4 :visible {(cpu_info?.fans?.v ?: "") != ""}
      (tip-heading :title "Fans")
      (box :space-evenly false
        (label :class "key" :hexpand true :xalign 0 :text "Speed")
        (label :class "value ${cpu_info?.fans?.lvl ?: ''}" :text "${cpu_info?.fans?.v ?: ''} rpm")))

    (tip-heading :title "Top Processes")
    (box :class "procs head" :space-evenly false
      (label :width 200 :xalign 0 :text "Process")
      (label :width 70 :xalign 1 :text "CPU%")
      (label :width 70 :xalign 1 :text "MEM"))
    (box :class "procs" :orientation "v" :space-evenly false
      (for proc in {cpu_info?.procs ?: []}
        (box :space-evenly false
          (label :width 200 :xalign 0 :limit-width 22 :text {proc.name})
          (label :class "value ${proc.lvl}" :width 70 :xalign 1 :text {proc.cpu})
          (label :width 70 :xalign 1 :text {proc.mem}))))))

;; RAM popup: one bar of the whole memory (used, cached, free), a bar for
;; swap, and the processes with the most memory.
(defwidget mem-tip []
  (box :class "info-tip mem-tip" :orientation "v" :space-evenly false :spacing 4 :width 280
    (tip-heading :title "Memory" :first true)
    (box :class "mem-stack" :space-evenly false
      (box :class "used" :width {round((mem_info?.stack?.used ?: 0) * 2.8, 0)} :height 12)
      (box :class "cached" :width {round((mem_info?.stack?.cached ?: 0) * 2.8, 0)} :height 12)
      (box :class "free" :hexpand true :height 12))
    (box :orientation "v" :space-evenly false
      (for row in {mem_info?.rows ?: []}
        (box :space-evenly false
          (label :class "swatch ${row.key}" :width 18 :xalign 0 :text "■")
          (label :class "key" :hexpand true :xalign 0 :text {row.key})
          (label :class "value ${row.lvl}" :width 90 :xalign 1 :text {row.v})
          (label :class "value ${row.lvl}" :width 60 :xalign 1 :text "${row.pct}%"))))
    (label :class "dim" :halign "end" :text "of ${mem_info?.total ?: '…'}")

    (tip-heading :title "Swap")
    (progress :class "level ${mem_info?.swap?.lvl ?: ''}" :value {mem_info?.swap?.pct ?: 0})
    (box :space-evenly false
      (label :class "key" :hexpand true :xalign 0 :text "Used")
      (label :class "value ${mem_info?.swap?.lvl ?: ''}" :xalign 1
             :text "${mem_info?.swap?.v ?: '…'} / ${mem_info?.swap?.total ?: '…'}")
      (label :class "value ${mem_info?.swap?.lvl ?: ''}" :width 60 :xalign 1 :text "${mem_info?.swap?.pct ?: '…'}%"))

    (tip-heading :title "Top Processes")
    (box :class "procs" :orientation "v" :space-evenly false
      (for proc in {mem_info?.procs ?: []}
        (box :space-evenly false :spacing 8
          (label :hexpand true :xalign 0 :limit-width 18 :text {proc.name})
          (label :width 70 :xalign 1 :text {proc.mem})
          (label :class "value ${proc.lvl}" :width 50 :xalign 1 :text "${proc.pct}%"))))))

;; One usage bar per disk (device), as disk-info lists them.
(defwidget disk-tip []
  (box :orientation "v" :space-evenly false
    (label :visible {arraylength(disk_info) == 0} :text "…")
    (box :orientation "v" :space-evenly false :spacing 6
      (for d in disk_info
        (box :orientation "v" :space-evenly false :spacing 2
          (label :halign "start" :text "${d.mounts}   ${d.used} / ${d.size}  (${d.pct}%)")
          (progress :class "disk ${d.pct >= 90 ? 'high' : d.pct >= 75 ? 'mid' : 'low'}"
                    :width 280 :value {d.pct}))))))

(defwidget time-tip []
  (box :orientation "v" :space-evenly false :spacing 4
    (calendar :day {today?.day ?: 1} :month {today?.month ?: 1} :year {today?.year ?: 2000}
              :show-details false)
    (label :halign "start" :text "${uptime}")))

;; One i3status block by name, hidden while i3status has none (no
;; backlight, no VPN tool). Clicks as in i3status-kb; hover sets `hover`
;; for the polls that run only then. Blocks with details wrap the label in
;; a widget tooltip.
(defwidget block [name]
  (eventbox :visible {(blocks?.[name]?.full_text ?: "") != ""}
            :onclick "scripts/block-click ${name} left"
            :onrightclick "scripts/block-click ${name} right"
            :onhover "${EWW_CMD} update hover=${name}"
            :onhoverlost "${EWW_CMD} update hover="
    (children)))

(defwidget block-label [name ?first]
  (label :class "block ${first == 'true' ? 'first' : ''}"
         :style "color: ${blocks?.[name]?.color ?: 'inherit'}"
         :text "${blocks?.[name]?.full_text ?: ''}"))

;; Text details (network: net_info, battery, volume and VPN: *_tip); "…" until
;; the first poll. A widget tooltip, not the label's :tooltip text: with
;; that the bar sometimes came up 0 px high.
(defwidget text-tip [text]
  (label :halign "start" :text {text != "" ? text : "…"}))

;; Syncthing: state, rates, needed files and bytes, errors, devices,
;; folders (~/bin/syncthing-status --details).
(defwidget syncthing-tip []
  (label :halign "start" :text {syncthing_info != "" ? syncthing_info : "…"}))

;; In the order of .config/i3status/config after i3status-kb's blocks.
(defwidget status []
  (box :class "status" :space-evenly false :halign "end"
    (block :name "kb" (block-label :name "kb" :first true))
    (block :name "power_mode" (block-label :name "power_mode"))
    (block :name "backlight" (block-label :name "backlight"))
    (block :name "vpn" (tooltip (text-tip :text vpn_tip) (block-label :name "vpn")))
    (block :name "syncthing" (tooltip (syncthing-tip) (block-label :name "syncthing")))
    (block :name "wireless" (tooltip (text-tip :text {net_info?.wireless ?: ""}) (block-label :name "wireless")))
    (block :name "ethernet" (tooltip (text-tip :text {net_info?.ethernet ?: ""}) (block-label :name "ethernet")))
    (block :name "battery" (tooltip (text-tip :text battery_tip) (block-label :name "battery")))
    (block :name "volume" (tooltip (text-tip :text volume_tip) (block-label :name "volume")))
    (block :name "cpu_usage" (tooltip (cpu-tip) (block-label :name "cpu_usage")))
    (block :name "memory" (tooltip (mem-tip) (block-label :name "memory")))
    (block :name "disk_info" (tooltip (disk-tip) (block-label :name "disk_info")))
    (block :name "time" (tooltip (time-tip) (block-label :name "time")))))

;; output: output name (eDP-1), height: pixels for the display scale
;; (logical pixels on sway, which scales them), tray: true on one output
;; only (eww has one tray).
;; X11: a dock window, i3 reserves the strip, as for i3bar. Wayland: a
;; layer surface with an exclusive zone, without keyboard focus. eww reads
;; the properties of its backend.
(defwindow bar [output height tray ?small]
  :monitor output
  :windowtype "dock"
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "${height}px" :anchor "top center")
  :reserve (struts :side "top" :distance "${height}px")
  :exclusive true
  :focusable "none"
  :namespace "eww-bar"
  (centerbox :class "bar ${theme} ${small == "true" ? "small" : ""}"
    ;; The mode after the workspaces, as i3bar shows it.
    (box :space-evenly false :halign "start"
      (workspace-buttons :output output)
      ;; Not for the workspace mode: its keys are on the workspaces.
      (label :visible {i3_mode != "" && !workspaces.keymap} :class "mode" :text i3_mode))
    (box)
    (box :space-evenly false :halign "end"
      (status)
      (box :visible tray
        (systray :class "tray" :icon-size 20 :spacing 4)))))
