#!/usr/bin/env bash
#
# touchpad - switch the touchpads between tap-to-click and press-to-click.
#
# xorg-conf/40-touchpad.conf starts every session with press-to-click (as on
# macOS); this changes it until the next login. It sets every device with a
# libinput tapping property, so the TrackPoint and mice are left alone. The
# choice is kept per session, and `restore` applies it again after X re-adds
# the touchpad (bin/input-restore). In sway (SWAYSOCK set) it sets the
# input type touchpad, which sway applies to touchpads added later too.
#
# Usage: touchpad tap      tap to click
#        touchpad click    press to click
#        touchpad toggle   switch to the other one
#        touchpad show     print tap or click
#        touchpad restore  apply the last choice of this session, if any
#
set -euo pipefail

readonly PROP="libinput Tapping Enabled"
readonly USAGE="usage: touchpad tap | click | toggle | show | restore"
readonly STATE_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/touchpad-tap"
readonly WM_MSG="$HOME/bin/wm-msg"
readonly SWAY_TOUCHPADS="type:touchpad"

die() { printf 'touchpad: %s\n' "$*" >&2; exit 1; }

is_sway() { [[ -n "${SWAYSOCK:-}" ]]; }

# sway's tap state of the first touchpad: enabled, disabled or empty.
sway_tap() {
    "$WM_MSG" -t get_inputs | jq -r 'first(.[] | select(.type == "touchpad") | .libinput.tap) // empty'
}

# Ids of the devices that support tapping.
touchpads() {
    local id
    for id in $(xinput list --id-only); do
        if xinput list-props "$id" 2>/dev/null | grep -F "	$PROP (" >/dev/null; then
            echo "$id"
        fi
    done
}

set_tapping() {
    local value="$1" id found=""
    if is_sway; then
        local state=disabled
        [[ "$value" -eq 1 ]] && state=enabled
        "$WM_MSG" -q input "$SWAY_TOUCHPADS" tap "$state"
        return
    fi
    for id in $(touchpads); do
        xinput set-prop "$id" "$PROP" "$value"
        found=1
    done
    [[ -n "$found" ]] || die "no touchpad found"
}

# State of the first touchpad.
show() {
    local id
    if is_sway; then
        case "$(sway_tap)" in
            enabled) echo tap ;;
            disabled) echo click ;;
            *) die "no touchpad found" ;;
        esac
        return
    fi
    # No `| head -n 1`: with two touchpads pipefail would report SIGPIPE.
    id="$(touchpads)"
    id="${id%%$'\n'*}"
    [[ -n "$id" ]] || die "no touchpad found"
    # No grep -q: an early exit would make pipefail report xinput's SIGPIPE.
    if xinput list-props "$id" | grep -F "	$PROP (" | grep ':[[:space:]]*1$' >/dev/null; then
        echo tap
    else
        echo click
    fi
}

remember() {
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "$1" > "$STATE_FILE"
}

main() {
    is_sway || [[ -n "${DISPLAY:-}" ]] || die "needs X or sway (DISPLAY and SWAYSOCK are not set)"
    case "${1:-}" in
        tap)    set_tapping 1; remember tap; echo "touchpad: tap to click" ;;
        click)  set_tapping 0; remember click; echo "touchpad: press to click" ;;
        restore)
            local choice
            choice="$(cat "$STATE_FILE" 2>/dev/null)" || exit 0
            case "$choice" in
                tap)   set_tapping 1 ;;
                click) set_tapping 0 ;;
            esac
            ;;
        toggle) if [[ "$(show)" == tap ]]; then main click; else main tap; fi ;;
        show)   show ;;
        *)      die "$USAGE" ;;
    esac
}

main "$@"
