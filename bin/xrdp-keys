#!/usr/bin/env bash
#
# xrdp-keys - $mod for an xrdp session: right Shift (keycode 62) becomes
# Super_L, in Mod4 (i3's $mod) instead of Shift.
#
# From the Mac (Royal TSx) no other key arrives as a held modifier. macOS
# drops the key-ups of keys pressed with Cmd (they stay pressed in X and i3
# keeps the keyboard); Ctrl with "Windows Keys Passthrough" and F19 arrive
# as a tap when pressed; unknown keys (Application) as scancode 0. And
# xorgxrdp turns every repeated key-down of an ordinary key into a release
# and a press (sendDownUpKeyEvent); only Shift, Ctrl, Alt, Win, Menu and
# Meta pass unchanged. Karabiner on the Mac sends right Shift for Cmd (and
# left Shift for the physical right Shift) while Royal TSx is in front.
#
# xrdp loads a fresh keymap on every reconnect, so this checks every
# POLL_S seconds and sets the key again; xev gets no MappingNotify (Xlib's
# XKB swallows it). Ends with the X session. Started by ~/.xprofile in xrdp
# sessions only.
#
# Usage: xrdp-keys
#
set -euo pipefail

readonly KEYCODE=62 FROM_KEYSYM=Shift_R KEYSYM=Super_L
readonly POLL_S="${XRDP_KEYS_POLL_S:-2}"

# Moves the key unless Mod4 has it already. Fails only once X is gone: a
# half-done change (the key already Super_L, still in Shift) makes `remove`
# fail, and the next check tries again.
apply() {
    local modmap
    modmap="$(xmodmap -pm)" || return 1
    grep -qE "^mod4 .*\\($(printf '0x%x' "$KEYCODE")\\)" <<< "$modmap" && return 0
    xmodmap -e "remove shift = $FROM_KEYSYM" -e "keycode $KEYCODE = $KEYSYM" \
        -e "add mod4 = $KEYSYM" 2>/dev/null || true
}

main() {
    while apply; do
        sleep "$POLL_S"
    done
}

main "$@"
