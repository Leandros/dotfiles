#!/usr/bin/env bash
#
# xrdp-keys - $mod for an xrdp session: keycode 114 becomes Super_L, in
# Mod4 (i3's $mod).
#
# The Mac's RDP client (Royal TSx) cannot send a held Super: macOS drops the
# key-ups of keys pressed with Cmd (they stay pressed in X and i3 keeps the
# keyboard), and Ctrl with "Windows Keys Passthrough" arrives only on
# release. A key the Mac maps to F19 arrives as keycode 114, which the xrdp
# keymap leaves empty. xrdp loads a fresh keymap on every reconnect, so this
# checks every POLL_S seconds and sets the key again; xev gets no
# MappingNotify (Xlib's XKB swallows it). Ends with the X session. Started
# by ~/.xprofile in xrdp sessions only.
#
# Usage: xrdp-keys
#
set -euo pipefail

readonly KEYCODE=114 KEYSYM=Super_L
readonly POLL_S="${XRDP_KEYS_POLL_S:-2}"

# Sets the key unless Mod4 has keycode 114 already. Fails once X is gone.
apply() {
    local modmap
    modmap="$(xmodmap -pm)" || return 1
    grep -qE "^mod4 .*\\($(printf '0x%x' "$KEYCODE")\\)" <<< "$modmap" && return 0
    xmodmap -e "keycode $KEYCODE = $KEYSYM" -e "add mod4 = $KEYSYM"
}

main() {
    while apply; do
        sleep "$POLL_S"
    done
}

main "$@"
