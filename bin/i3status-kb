#!/usr/bin/env bash
#
# i3status-kb - i3status with a keyboard layout block in front.
#
# Runs i3status, adds a "KB: <layout>" block to every status line and cycles
# the layout with `kb` when the block is clicked (left: next, right: prev).
# A "PWR: <mode>" block after it shows the power mode from `pwr mode`.
# A "☀: <percent>" block after that shows the screen brightness, and a
# "VPN: <connection>" block the active NetworkManager VPN or WireGuard
# connection and Tailscale (green), or "VPN: off".
# A left click on the wireless or ethernet block opens nmrs-gui, on the
# volume block pavucontrol.
# Use as `status_command` in the i3 bar.
#
set -euo pipefail

readonly KB="$HOME/bin/kb"
readonly BLOCK_NAME="kb"
readonly BUTTON_LEFT=1
readonly BUTTON_RIGHT=3
readonly NETWORK_GUI="nmrs-gui"
readonly AUDIO_GUI="pavucontrol"
readonly PWR="$HOME/bin/pwr"
readonly MODE_BLOCK_NAME="power_mode"
readonly BACKLIGHT_BLOCK_NAME="backlight"
readonly VPN_BLOCK_NAME="vpn"
# i3status color_good (~/.config/i3status/config).
readonly COLOR_GOOD="#859900"
# The bar asks every few seconds; it must not block on a stuck daemon
# (NetworkManager, tailscaled).
readonly NMCLI_TIMEOUT_S=2
readonly SYSFS="${I3STATUS_KB_SYSFS:-/sys}"
# i3status cannot request clicks itself; i3bar only sends them when the
# header asks for them.
readonly HEADER='{"version":1,"click_events":true}'
FIFO=""

layout_block() {
    printf '{"name":"%s","full_text":"KB: %s"}' "$BLOCK_NAME" "$("$KB" show)"
}

# Empty without a power profile daemon.
mode_block() {
    local mode
    mode="$("$PWR" mode 2>/dev/null)" || return 0
    [[ -n "$mode" ]] || return 0
    printf ',{"name":"%s","full_text":"PWR: %s"}' "$MODE_BLOCK_NAME" "$mode"
}

# First backlight device, as brightnessctl picks it. Empty without one
# (desktop monitors).
backlight_block() {
    local dev cur max
    for dev in "$SYSFS"/class/backlight/*; do
        [[ -r "$dev/brightness" && -r "$dev/max_brightness" ]] || continue
        read -r cur < "$dev/brightness"
        read -r max < "$dev/max_brightness"
        [[ "$max" -gt 0 ]] || continue
        printf ',{"name":"%s","full_text":"☀: %d%%"}' "$BACKLIGHT_BLOCK_NAME" $(((cur * 100 + max / 2) / max))
        return 0
    done
}

# JSON string content: backslash and double quote escaped.
json_escape() {
    local s="${1//\\/\\\\}"
    echo "${s//\"/\\\"}"
}

# First active NetworkManager connection of type vpn (OpenVPN and other
# plugins) or wireguard, and Tailscale when its backend runs. `nmcli -t`
# escapes ":" and "\" in names with a backslash. Empty without either.
vpn_block() {
    local names=() sources=0 active line name status joined="" n
    if active="$(timeout "$NMCLI_TIMEOUT_S" nmcli -t -f NAME,TYPE connection show --active 2>/dev/null)"; then
        sources=1
        while IFS= read -r line; do
            case "${line##*:}" in
                vpn|wireguard)
                    name="${line%:*}"
                    name="${name//\\:/:}"
                    names+=("${name//\\\\/\\}")
                    break
                    ;;
            esac
        done <<< "$active"
    fi
    # Tailscale runs outside NetworkManager. No `| grep -q`: an early exit
    # would make pipefail report tailscale's SIGPIPE.
    if command -v tailscale >/dev/null; then
        sources=1
        status="$(timeout "$NMCLI_TIMEOUT_S" tailscale status --json 2>/dev/null)" || true
        [[ "$status" =~ \"BackendState\":\ *\"Running\" ]] && names+=("Tailscale")
    fi
    [[ "$sources" -eq 1 ]] || return 0
    if [[ ${#names[@]} -eq 0 ]]; then
        printf ',{"name":"%s","full_text":"VPN: off"}' "$VPN_BLOCK_NAME"
        return
    fi
    for n in "${names[@]}"; do
        joined+="${joined:+, }$(json_escape "$n")"
    done
    printf ',{"name":"%s","full_text":"VPN: %s","color":"%s"}' "$VPN_BLOCK_NAME" "$joined" "$COLOR_GOOD"
}

# i3bar writes one click event per line on stdin, after a leading "[".
handle_clicks() {
    local line
    while read -r line; do
        case "$line" in
            *"\"name\":\"$BLOCK_NAME\""*) layout_click "$line" ;;
            *'"name":"wireless"'*|*'"name":"ethernet"'*) gui_click "$line" "$NETWORK_GUI" ;;
            *'"name":"volume"'*) gui_click "$line" "$AUDIO_GUI" ;;
        esac
    done
}

is_button() {
    local line="$1" button="$2"
    [[ "$line" == *"\"button\":$button,"* || "$line" == *"\"button\":$button}"* ]]
}

layout_click() {
    local line="$1"
    if is_button "$line" "$BUTTON_LEFT"; then
        "$KB" next >/dev/null
    elif is_button "$line" "$BUTTON_RIGHT"; then
        "$KB" prev >/dev/null
    else
        return 0
    fi
    # Redraw now instead of at the next interval.
    kill -USR1 "$I3STATUS_PID"
}

# i3 starts the GUI, so it is not in this script's process group, which
# cleanup kills when the bar restarts. The i3 command is one argument;
# i3-msg would read --no-startup-id as its own option.
gui_click() {
    is_button "$1" "$BUTTON_LEFT" || return 0
    i3-msg -q "exec --no-startup-id $2" || true
}

# Insert the blocks at the front of the status array. The line is either
# "[...]" or ",[...]"; an empty array needs no trailing comma.
with_block() {
    local line="$1" prefix rest blocks
    prefix="${line%%\[*}"
    rest="${line#*\[}"
    blocks="$(layout_block)$(mode_block)$(backlight_block)$(vpn_block)"
    if [[ "$rest" == "]" ]]; then
        echo "${prefix}[${blocks}]"
    else
        echo "${prefix}[${blocks},$rest"
    fi
}

cleanup() {
    rm -f "$FIFO"
    kill 0 2>/dev/null
}

main() {
    FIFO="$(mktemp -u)"
    mkfifo -m 600 "$FIFO"
    trap cleanup EXIT

    i3status > "$FIFO" &
    I3STATUS_PID=$!
    # Explicit stdin: a background job otherwise reads /dev/null.
    handle_clicks <&0 &

    local line
    {
        # Replace the header; the opening "[" of the endless array passes through.
        read -r line && echo "$HEADER"
        read -r line && echo "$line"
        while read -r line; do
            with_block "$line"
        done
    } < "$FIFO"
}

main "$@"
