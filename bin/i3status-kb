#!/usr/bin/env bash
#
# i3status-kb - i3status with a keyboard layout block in front.
#
# Runs i3status, adds a "KB: <layout>" block to every status line and cycles
# the layout with `kb` when the block is clicked (left: next, right: prev).
# A "PWR: <mode>" block after it shows the power mode from `pwr mode`.
# A left click on the wireless or ethernet block opens nmrs-gui.
# Use as `status_command` in the i3 bar.
#
set -euo pipefail

readonly KB="$HOME/bin/kb"
readonly BLOCK_NAME="kb"
readonly BUTTON_LEFT=1
readonly BUTTON_RIGHT=3
readonly NETWORK_GUI="nmrs-gui"
readonly PWR="$HOME/bin/pwr"
readonly MODE_BLOCK_NAME="power_mode"
# i3status cannot request clicks itself; i3bar only sends them when the
# header asks for them.
readonly HEADER='{"version":1,"click_events":true}'
FIFO=""

layout_block() {
    printf '{"name":"%s","full_text":"KB: %s"}' "$BLOCK_NAME" "$("$KB" show)"
}

# Empty without a power profile daemon.
mode_block() {
    local mode
    mode="$("$PWR" mode 2>/dev/null)" || return 0
    [[ -n "$mode" ]] || return 0
    printf ',{"name":"%s","full_text":"PWR: %s"}' "$MODE_BLOCK_NAME" "$mode"
}

# i3bar writes one click event per line on stdin, after a leading "[".
handle_clicks() {
    local line
    while read -r line; do
        case "$line" in
            *"\"name\":\"$BLOCK_NAME\""*) layout_click "$line" ;;
            *'"name":"wireless"'*|*'"name":"ethernet"'*) network_click "$line" ;;
        esac
    done
}

is_button() {
    local line="$1" button="$2"
    [[ "$line" == *"\"button\":$button,"* || "$line" == *"\"button\":$button}"* ]]
}

layout_click() {
    local line="$1"
    if is_button "$line" "$BUTTON_LEFT"; then
        "$KB" next >/dev/null
    elif is_button "$line" "$BUTTON_RIGHT"; then
        "$KB" prev >/dev/null
    else
        return 0
    fi
    # Redraw now instead of at the next interval.
    kill -USR1 "$I3STATUS_PID"
}

# i3 starts the GUI, so it is not in this script's process group, which
# cleanup kills when the bar restarts. The i3 command is one argument;
# i3-msg would read --no-startup-id as its own option.
network_click() {
    is_button "$1" "$BUTTON_LEFT" || return 0
    i3-msg -q "exec --no-startup-id $NETWORK_GUI" || true
}

# Insert the blocks at the front of the status array. The line is either
# "[...]" or ",[...]"; an empty array needs no trailing comma.
with_block() {
    local line="$1" prefix rest blocks
    prefix="${line%%\[*}"
    rest="${line#*\[}"
    blocks="$(layout_block)$(mode_block)"
    if [[ "$rest" == "]" ]]; then
        echo "${prefix}[${blocks}]"
    else
        echo "${prefix}[${blocks},$rest"
    fi
}

cleanup() {
    rm -f "$FIFO"
    kill 0 2>/dev/null
}

main() {
    FIFO="$(mktemp -u)"
    mkfifo -m 600 "$FIFO"
    trap cleanup EXIT

    i3status > "$FIFO" &
    I3STATUS_PID=$!
    # Explicit stdin: a background job otherwise reads /dev/null.
    handle_clicks <&0 &

    local line
    {
        # Replace the header; the opening "[" of the endless array passes through.
        read -r line && echo "$HEADER"
        read -r line && echo "$line"
        while read -r line; do
            with_block "$line"
        done
    } < "$FIFO"
}

main "$@"
