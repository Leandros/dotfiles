#!/usr/bin/env bash
#
# caffeinate - keep the machine awake while this runs, like macOS caffeinate.
#
# Runs in the foreground until Ctrl-C. Idle lock and suspend come from
# xidlehook (~/.xprofile): timer 0 locks, timer 1 suspends. This disables
# the suspend timer through xidlehook's socket and enables it again on exit.
# A logind inhibitor would not help: logind before systemd 257 lets a
# user's own `systemctl suspend` pass that user's inhibitors.
#
# With `display` both timers are off, and the X idle time, which DPMS
# blanks on, is reset every minute. Only `kill -9` would keep the timers
# disabled (`xidlehook-client ... --action enable`).
#
# Closing the lid and `pwr sleep` still suspend.
#
# In sway (SWAYSOCK set) a logind inhibitor does it, held by
# systemd-inhibit while this runs. swayidle skips its timeouts while an
# idle inhibitor exists, and since systemd 257 logind also refuses the
# owner's `systemctl suspend` while a sleep inhibitor blocks it: idle
# suspend, but also `pwr sleep`. Closing the lid still suspends.
#
# Usage: caffeinate           no idle suspend
#        caffeinate display   no idle suspend, lock or screen blanking
#
set -euo pipefail

# Well below DPMS blanking (10 minutes by default).
readonly INTERVAL_S="${CAFFEINATE_INTERVAL_S:-60}"
readonly SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/xidlehook.sock"
readonly SUSPEND_TIMER=1
# The timers to hold off: the suspend timer, or all (empty) with display.
TIMERS=("--timer" "$SUSPEND_TIMER")
readonly USAGE="usage: caffeinate [display]"
readonly MESSAGE="no idle suspend" DISPLAY_MESSAGE="no idle suspend, lock or blanking"
SLEEP_PID=""

die() { printf 'caffeinate: %s\n' "$*" >&2; exit 1; }

is_sway() { [[ -n "${SWAYSOCK:-}" ]]; }

cleanup() {
    # A second Ctrl-C (or a signal to the whole process group) must not
    # stop the enable; children inherit the ignored signals.
    trap '' INT TERM HUP
    # Ctrl-C reaches the whole process group, so sleep is often gone already.
    if [[ -n "$SLEEP_PID" ]]; then kill "$SLEEP_PID" 2>/dev/null || true; fi
    is_sway || timers enable || true
    echo "caffeinate: idle suspend on again"
}

# sway: the lock goes with systemd-inhibit. It runs in the background, so a
# signal ends `wait` at once; a background job ignores SIGINT, so Ctrl-C
# reaches only this script, and cleanup stops it.
inhibit() {
    local what="sleep" why="$MESSAGE"
    if [[ -n "$1" ]]; then
        what="idle:sleep"
        why="$DISPLAY_MESSAGE"
    fi
    systemd-inhibit --what="$what" --who=caffeinate --why="$why" sleep infinity &
    SLEEP_PID=$!
    echo "caffeinate: $why; Ctrl-C to stop"
    wait "$SLEEP_PID" || true
    die "systemd-inhibit ended; no inhibitor"
}

# Enables or disables the held-off xidlehook timers.
timers() {
    xidlehook-client --socket "$SOCKET" control --action "$1" ${TIMERS[@]+"${TIMERS[@]}"} >/dev/null 2>&1
}

main() {
    local display=""
    case "${1:-}" in
        "")      ;;
        display) display=1; TIMERS=() ;;
        *)       die "$USAGE" ;;
    esac
    is_sway || [[ -n "${DISPLAY:-}" ]] || die "needs X or sway (DISPLAY and SWAYSOCK are not set)"

    trap cleanup EXIT
    # Exit codes as for a signal death: 128 + signal number.
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    if is_sway; then
        inhibit "$display"
    fi
    timers disable || echo "caffeinate: xidlehook not running, no idle suspend to stop" >&2
    if [[ -n "$display" ]]; then
        echo "caffeinate: $DISPLAY_MESSAGE; Ctrl-C to stop"
    else
        echo "caffeinate: $MESSAGE; Ctrl-C to stop"
    fi

    while true; do
        [[ -n "$display" ]] && xset s reset
        # In the background so a signal ends `wait` at once.
        sleep "$INTERVAL_S" &
        SLEEP_PID=$!
        wait "$SLEEP_PID"
    done
}

main "$@"
