#!/usr/bin/env bash
#
# kb - switch the keyboard layout of the X or sway session or the virtual
# consoles.
#
# Inside X (DISPLAY set) it changes only the session's X keyboard, in sway
# (SWAYSOCK set) only sway's keyboards; with --console also the consoles.
# On a tty it changes only the consoles. The console layout is system-wide:
# consoles run by kmscon (Fedora 45+) follow localectl's X11 settings, which
# are also the X server default (the login screen, keyboards X adds), and
# fbcon consoles share the kernel keymap (loadkeys). So a session must not
# change it by itself.
#
# Usage: kb [--console]            interactive menu
#        kb [--console] us|de|bone2
#        kb [--console] next|prev  cycle through the layouts
#        kb show                   print the session's layout
#
set -euo pipefail

readonly LAYOUTS=(us de bone2)
# sway also sets DISPLAY (Xwayland), so SWAYSOCK decides first.
if [[ -n "${SWAYSOCK:-}" ]]; then
    SESSION="sway"
elif [[ -n "${DISPLAY:-}" ]]; then
    SESSION="x"
else
    SESSION="tty"
fi
readonly SESSION
# Remembered per X or Wayland display so the status bar does not query the
# session on every tick; two sessions (local and xrdp) keep their own
# layouts. Unused on a tty.
session_key="${DISPLAY:-}"
[[ "$SESSION" != sway ]] || session_key="${WAYLAND_DISPLAY:-}"
readonly STATE_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/kb-layout-$session_key"
# `swaymsg reload` drops input commands; the sway config includes this file.
readonly SWAY_CONF="$HOME/.config/sway.d/kb.conf"
readonly XMODMAP_FILE="$HOME/.Xmodmap"
# Console keymap for bone2, generated from ~/.Xmodmap; lives next to this script.
DOTFILES_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
readonly DOTFILES_DIR
readonly BONE2_CONSOLE_MAP="$DOTFILES_DIR/console/bone2.map"
# xmodmap sends one request per key and every client reloads its keymap each
# time, which takes seconds on a busy desktop. The resulting keymap is dumped
# once and reloaded in a single xkbcomp request afterwards.
readonly XKB_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kb"

die() { printf 'kb: %s\n' "$*" >&2; exit 1; }

# ~/.xprofile sets this; a plain `setxkbmap <layout>` call would clear it.
readonly XKB_OPTIONS="terminate:ctrl_alt_bksp"

# Compiled bone2 keymap, keyed by the xmodmap content so edits invalidate it.
bone2_xkb_cache() {
    local digest
    digest="$(sha256sum "$XMODMAP_FILE" | cut -c1-16)"
    echo "$XKB_CACHE_DIR/bone2-$digest.xkb"
}

# bone2 is the de layout with the Neo-derived levels from ~/.Xmodmap.
apply_x_bone2() {
    local cache
    cache="$(bone2_xkb_cache)"
    if [[ -s "$cache" ]]; then
        xkbcomp -w0 "$cache" "$DISPLAY"
        return
    fi
    setxkbmap -layout de -option "$XKB_OPTIONS"
    xmodmap "$XMODMAP_FILE"
    mkdir -p "$XKB_CACHE_DIR"
    xkbcomp -w0 "$DISPLAY" "$cache.tmp" && mv "$cache.tmp" "$cache"
}

apply_x() {
    case "$1" in
        us)    setxkbmap -layout us -option "$XKB_OPTIONS" ;;
        de)    setxkbmap -layout de -option "$XKB_OPTIONS" ;;
        bone2) apply_x_bone2 ;;
    esac
}

# One layout, no XKB groups: some keyboards make bone2 in firmware. bone2 is
# ~/.config/xkb/symbols/bone2. sway merges the type:keyboard settings, so
# the xkb_options of the sway config stay.
apply_sway() {
    local reply error escaped_quote='\"' escaped_slash='\/'
    if reply="$(swaymsg input type:keyboard xkb_layout "$1" 2>&1)"; then
        mkdir -p "$(dirname "$SWAY_CONF")"
        echo "input type:keyboard xkb_layout $1" > "$SWAY_CONF"
        return
    fi
    # swaymsg exits 2 on "success": false and prints the reply as JSON.
    error="$reply"
    if [[ "$reply" =~ \"error\":\ *\"(([^\"\\]|\\.)*)\" ]]; then
        error="${BASH_REMATCH[1]//"$escaped_quote"/\"}"
        error="${error//"$escaped_slash"//}"
    fi
    die "sway did not set layout $1: $error"
}

# Layout names as libxkbcommon reports them (xkeyboard-config, xkb/symbols/bone2).
layout_of_name() {
    case "$1" in
        "English (US)")      echo us ;;
        "German")            echo de ;;
        "Bone 2 (dotfiles)") echo bone2 ;;
        *)                   return 1 ;;
    esac
}

# Only prompt for the sudo password from a terminal; from .xprofile or a
# bar click the prompt would block (startx leaves the console as stdin).
as_root() {
    local sudo_opts=()
    [[ -t 0 ]] || sudo_opts=(-n)
    sudo "${sudo_opts[@]+"${sudo_opts[@]}"}" "$@"
}

# kmscon owns the consoles when one of its per-VT units is running.
kmscon_active() {
    command -v kmscon >/dev/null || return 1
    [[ -n "$(systemctl list-units --state=active --plain --no-legend 'kmsconvt@*' 2>/dev/null)" ]]
}

# kmscon follows the X11 keymap published by localed. There is no system xkb
# file for the custom bone2 (xkb/symbols/bone2 is the user's), so the stock
# de(bone) variant stands in for it.
apply_console_kmscon() {
    local args
    case "$1" in
        us)    args=(us) ;;
        de)    args=(de) ;;
        bone2) args=(de "" bone) ;;
    esac
    # --no-convert: leave the fbcon keymap in /etc/vconsole.conf alone.
    as_root localectl --no-convert set-x11-keymap "${args[@]}" 2>/dev/null \
        || echo "kb: console layout unchanged" >&2
}

# The kernel keymap is shared by all fbcon consoles. Setting it needs the
# console as controlling tty or CAP_SYS_TTY_CONFIG, so fall back to sudo
# when run from X.
apply_console_fbcon() {
    local keymap
    case "$1" in
        us)    keymap="us" ;;
        de)    keymap="de-latin1" ;;
        bone2) keymap="$BONE2_CONSOLE_MAP" ;;
    esac
    # -u: the map uses U+ keysyms; without a console loadkeys cannot detect
    # Unicode mode itself.
    if loadkeys -u -q "$keymap" 2>/dev/null; then
        return
    fi
    as_root loadkeys -u -q "$keymap" 2>/dev/null \
        || echo "kb: console layout unchanged" >&2
}

apply_console() {
    if kmscon_active; then
        apply_console_kmscon "$1"
    else
        apply_console_fbcon "$1"
    fi
}

apply_console_checked() {
    if command -v loadkeys >/dev/null || command -v kmscon >/dev/null; then
        apply_console "$1"
    else
        echo "kb: neither loadkeys nor kmscon found, console layout unchanged" >&2
    fi
}

# In a session (X or sway): its keyboards, plus the consoles with --console.
# On a tty: the consoles only; the state file records the session's layout
# for the bar, so it stays.
apply() {
    [[ " ${LAYOUTS[*]} " == *" $1 "* ]] || die "unknown layout: $1 (one of: ${LAYOUTS[*]})"
    if [[ "$SESSION" == tty ]]; then
        apply_console_checked "$1"
        echo "console keyboard layout: $1"
        return
    fi
    local where=X
    if [[ "$SESSION" == sway ]]; then
        where=sway
        apply_sway "$1"
    else
        apply_x "$1"
    fi
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "$1" > "$STATE_FILE"
    if [[ -n "$CONSOLE" ]]; then
        apply_console_checked "$1"
        echo "keyboard layout: $1 ($where and console)"
    else
        echo "keyboard layout: $1"
    fi
}

# Without a state file (first call after login) read the X server: bone2 puts
# j on keycode 24, where us and de have q.
detect_x() {
    [[ -n "${DISPLAY:-}" ]] || return 1
    # No grep -q: it would exit early and pipefail would report xmodmap's SIGPIPE.
    if xmodmap -pke 2>/dev/null | grep '^keycode  24 = j ' >/dev/null; then
        echo bone2
        return
    fi
    setxkbmap -query 2>/dev/null | awk '/^layout:/ { print $2 }' | cut -d, -f1 | grep .
}

# All keyboards have the type:keyboard layout. Virtual keyboards (wtype) have
# a null name, so take the first name.
detect_sway() {
    local inputs
    inputs="$(swaymsg -t get_inputs 2>/dev/null)" || return 1
    [[ "$inputs" =~ \"xkb_active_layout_name\":\ *\"([^\"]*)\" ]] || return 1
    layout_of_name "${BASH_REMATCH[1]}"
}

detect() {
    case "$SESSION" in
        sway) detect_sway ;;
        x)    detect_x ;;
        *)    return 1 ;;
    esac
}

show() {
    if [[ -s "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
        return
    fi
    local detected
    if detected="$(detect)"; then
        mkdir -p "$(dirname "$STATE_FILE")"
        echo "$detected" > "$STATE_FILE"
        echo "$detected"
    else
        echo "?"
    fi
}

# Neighbour of the current layout in the LAYOUTS ring; unknown starts at the first.
cycle() {
    local step="$1" current i index=0
    current="$(show)"
    for i in "${!LAYOUTS[@]}"; do
        [[ "${LAYOUTS[$i]}" == "$current" ]] && index="$i"
    done
    echo "${LAYOUTS[$(( (index + step + ${#LAYOUTS[@]}) % ${#LAYOUTS[@]} ))]}"
}

# Menu on stderr so the chosen name is the only thing on stdout.
choose() {
    local i
    for i in "${!LAYOUTS[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "${LAYOUTS[$i]}" >&2
    done
    local reply
    read -r -p "layout [1-${#LAYOUTS[@]}]: " reply
    [[ "$reply" =~ ^[0-9]+$ && "$reply" -ge 1 && "$reply" -le "${#LAYOUTS[@]}" ]] || die "invalid choice: $reply"
    echo "${LAYOUTS[$((reply - 1))]}"
}

# Set by --console.
CONSOLE=""

main() {
    local args=() arg
    for arg in "$@"; do
        case "$arg" in
            --console) CONSOLE=1 ;;
            -*) die "unknown option: $arg (usage: kb [--console] [us|de|bone2|next|prev|show])" ;;
            *) args+=("$arg") ;;
        esac
    done
    case "${args[0]:-}" in
        "")   apply "$(choose)" ;;
        show) show ;;
        next) apply "$(cycle 1)" ;;
        prev) apply "$(cycle -1)" ;;
        *)    apply "${args[0]}" ;;
    esac
}

main "$@"
