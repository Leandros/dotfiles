#!/usr/bin/env bash
#
# pwr - lock, suspend or hibernate now, or switch the power mode.
#
# xss-lock (started from ~/.xprofile) runs `pwr lock --nofork` on idle
# and before every suspend or hibernation. Locking through logind lets
# xss-lock start its single i3lock; a second i3lock could not grab the
# keyboard. Without xss-lock (EL9), i3lock runs directly. Only the power
# button wakes the machine (system-sleep/power-button-wake).
#
# In sway (SWAYSOCK set) swayidle runs `pwr lock` on logind's Lock signal
# (`loginctl lock-session`, idle) and before sleep, so `pwr lock` runs
# swaylock itself; through logind it would loop.
#
# Power modes go through the power-profiles-daemon D-Bus API (tuned-ppd on
# Fedora); it sets the ThinkPad firmware mode and the CPU energy settings.
# power-mode/power-mode-auto picks the mode when the AC adapter changes.
#
# Usage: pwr lock            lock now
#        pwr lock --nofork   run i3lock (swaylock) in the foreground (xss-lock locker)
#        pwr sleep           suspend now
#        pwr hibernate       hibernate now
#        pwr performance     maximum performance
#        pwr balanced        balance performance and power use
#        pwr battery         longest battery life
#        pwr mode            print the power mode (i3 bar)
#
set -euo pipefail

# Solarized base02, the i3 desktop background.
readonly COLOR="073642"
readonly USAGE="usage: pwr lock [--nofork] | sleep | hibernate | performance | balanced | battery | mode"
readonly PPD_NAME="org.freedesktop.UPower.PowerProfiles"
readonly PPD_PATH="/org/freedesktop/UPower/PowerProfiles"
readonly PPD_PROPERTY="ActiveProfile"
# The i3 bar asks every few seconds; it must not block on a stuck daemon.
readonly PPD_TIMEOUT_S=2
# The lock screen always takes the password in this layout (see kb).
readonly LOCK_LAYOUT="bone2"
readonly FORK="fork" NOFORK="nofork"
# kb lives next to this script; xss-lock may not have ~/bin on its PATH.
KB="$(dirname "$(readlink -f "$0")")/kb"
readonly KB

usage() {
    echo "$USAGE" >&2
    exit 2
}

is_sway() { [[ -n "${SWAYSOCK:-}" ]]; }

running() { pgrep -u "$(id -u)" -x "$1" >/dev/null; }

xss_lock_running() { running xss-lock; }

# The daemon that locks before sleep: xss-lock, or swayidle in sway.
sleep_locker_running() {
    if is_sway; then
        running swayidle
        return
    fi
    xss_lock_running
}

locker_name() {
    if is_sway; then echo swaylock; else echo i3lock; fi
}

# i3lock or swaylock; FORK: it forks once it holds the keyboard.
run_locker() {
    local fork="$1"
    if is_sway; then
        if [[ "$fork" == "$FORK" ]]; then swaylock -f -c "$COLOR"; else swaylock -c "$COLOR"; fi
        return
    fi
    if [[ "$fork" == "$FORK" ]]; then i3lock --color "$COLOR"; else i3lock --nofork --color "$COLOR"; fi
}

# Switch to the lock layout and print the layout to restore after unlocking,
# or nothing when no switch was needed. A failed switch never stops the lock.
lock_layout_enter() {
    local current
    current="$("$KB" show 2>/dev/null)" || current=""
    [[ "$current" != "$LOCK_LAYOUT" ]] || return 0
    "$KB" "$LOCK_LAYOUT" >/dev/null 2>&1 || return 0
    [[ "$current" != "?" ]] && echo "$current"
    return 0
}

lock_layout_restore() {
    [[ -n "$1" ]] || return 0
    "$KB" "$1" >/dev/null 2>&1 || true
}

# The locker forks once it holds the keyboard. Callers rely on that to
# suspend only after the screen is locked, so the layout is restored in the
# background once the forked locker exits.
lock_forking() {
    local previous pid status=0 name
    name="$(locker_name)"
    # sway has one lock client at a time; a second swaylock fails (idle
    # lock, then before-sleep).
    if is_sway && running "$name"; then
        return 0
    fi
    previous="$(lock_layout_enter)"
    run_locker "$FORK" || status=$?
    if [[ -n "$previous" ]]; then
        if pid="$(pgrep -n -u "$(id -u)" -x "$name")"; then
            (tail --pid="$pid" -f /dev/null; lock_layout_restore "$previous") \
                </dev/null >/dev/null 2>&1 &
            disown
        else
            lock_layout_restore "$previous"
        fi
    fi
    return "$status"
}

lock() {
    local previous status=0
    case "${1:-}" in
        --nofork)
            previous="$(lock_layout_enter)"
            run_locker "$NOFORK" || status=$?
            lock_layout_restore "$previous"
            exit "$status"
            ;;
        "") ;;
        *) usage ;;
    esac

    if ! is_sway && xss_lock_running; then
        exec loginctl lock-session
    fi
    lock_forking
}

# xss-lock (swayidle) locks on logind's PrepareForSleep signal. Without it
# the screen must be locked first; the locker forks once it holds the
# keyboard. A console without X or sway has no locker.
enter() {
    local action="$1"
    if { is_sway || [[ -n "${DISPLAY:-}" ]]; } && ! sleep_locker_running; then
        lock_forking
    fi
    exec systemctl "$action"
}

# Power profile names of the D-Bus API; "battery" is "power-saver" there.
set_mode() {
    local profile="$1"
    busctl --timeout="$PPD_TIMEOUT_S" set-property \
        "$PPD_NAME" "$PPD_PATH" "$PPD_NAME" "$PPD_PROPERTY" s "$profile"
    # Redraw the i3 bar now instead of at the next interval.
    pkill -USR1 -x i3status 2>/dev/null || true
}

show_mode() {
    local reply profile
    reply="$(busctl --timeout="$PPD_TIMEOUT_S" get-property \
        "$PPD_NAME" "$PPD_PATH" "$PPD_NAME" "$PPD_PROPERTY")"
    # Reply format: s "power-saver"
    profile="${reply#s \"}"
    profile="${profile%\"}"
    case "$profile" in
        power-saver) echo battery ;;
        *) echo "$profile" ;;
    esac
}

main() {
    [[ $# -ge 1 ]] || usage
    local command="$1"
    shift

    case "$command" in
        lock)
            [[ $# -le 1 ]] || usage
            lock "$@"
            ;;
        sleep)
            [[ $# -eq 0 ]] || usage
            enter suspend
            ;;
        hibernate)
            [[ $# -eq 0 ]] || usage
            enter hibernate
            ;;
        performance|balanced)
            [[ $# -eq 0 ]] || usage
            set_mode "$command"
            ;;
        battery)
            [[ $# -eq 0 ]] || usage
            set_mode power-saver
            ;;
        mode)
            [[ $# -eq 0 ]] || usage
            show_mode
            ;;
        *) usage ;;
    esac
}

main "$@"
