#!/usr/bin/env bash
#
# pbpaste - print the clipboard, as macOS's pbpaste (Linux; ~/bin, linked by
# bootstrap). The same choice as pbcopy: Wayland, then X, else tmux.
# `pbpaste --primary` prints the primary selection instead (Wayland and X;
# .zshrc's vi mode p falls back to it when the clipboard is empty).
# Test: test/zsh-clipboard/test.sh.
#
set -euo pipefail

primary=0
[[ "${1:-}" == --primary ]] && primary=1

if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-paste >/dev/null; then
    if (( primary )); then exec wl-paste -n -p; else exec wl-paste -n; fi
elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null; then
    if (( primary )); then exec xclip -selection primary -o; else exec xclip -selection clipboard -o; fi
elif (( ! primary )); then
    exec tmux save-buffer -
fi
