+#[cfg(test)]
+mod tests {
+    use figment::{
+        Figment,
+        providers::{Format, Yaml},
+    };
+
+    use super::calculate_geometry;
+    use crate::{options::Options, sway};
+
+    // A workspace as `swaymsg -t get_tree` prints it (JSON is YAML too).
+    fn parse(json: &str) -> swayipc::Node {
+        Figment::from(Yaml::string(json))
+            .extract()
+            .expect("valid tree")
+    }
+
+    // The label x of each window, relative to the workspace's output
+    // (the workspace stands in for the output; both start at x = 0).
+    fn label_xs(workspace: &swayipc::Node) -> Vec<i32> {
+        let opts = Options::default();
+        let mut xs: Vec<i32> = sway::get_all_windows(workspace)
+            .iter()
+            .map(|w| calculate_geometry(w, workspace, &opts).0)
+            .collect();
+        xs.sort();
+        xs
+    }
+
+    // splith: [splitv: [A, B], C]. C is a direct child of the workspace,
+    // so sway reports its deco_rect.x (1024) relative to the workspace,
+    // like its rect.x (1024): the label must not land at 2048 + margin,
+    // off a 2048 px wide output.
+    #[test]
+    fn split_labels_stay_on_their_windows() {
+        let ws = parse(include_str!("../tests/fixtures/split-workspace.json"));
+        // rect.x + window_rect.x (border 2) + label_margin_x (4).
+        assert_eq!(label_xs(&ws), vec![6, 6, 1030]);
+    }
+
+    // Tabbed: both children share the parent's rect; deco_rect.x is the
+    // tab offset, which the label needs.
+    #[test]
+    fn tabbed_labels_follow_their_tabs() {
+        let ws = parse(include_str!("../tests/fixtures/tabbed-workspace.json"));
+        assert_eq!(label_xs(&ws), vec![6, 1030]);
+    }
+
+    // Tabbed: [A, splitv: [B, C]]. B and C have title bars of their own at
+    // the left of the tabbed container, one row below A's tab: their labels
+    // start at their tab, else B's label covers A's.
+    #[test]
+    fn labels_in_a_nested_tab_follow_their_tab() {
+        let ws = parse(include_str!(
+            "../tests/fixtures/tabbed-nested-workspace.json"
+        ));
+        assert_eq!(label_xs(&ws), vec![1030, 1542, 1542]);
+    }
+
+    // Tabbed: [A, splith: [B, C]] on a 3840 px output, both tabs 1920 px
+    // wide. B's title bar starts at x = 0 one row (25 px) below A's tab:
+    // with 60 px high labels, B's label covered A's.
+    #[test]
+    fn labels_in_a_nested_split_do_not_cover_the_tab_labels() {
+        let ws = parse(include_str!(
+            "../tests/fixtures/tabbed-nested-splith-workspace.json"
+        ));
+        let opts = Options::default();
+        let mut boxes: Vec<(i32, i32, i32, i32)> = sway::get_all_windows(&ws)
+            .iter()
+            .map(|w| {
+                let (x, y) = calculate_geometry(w, &ws, &opts);
+                (x, y, 40, 60)
+            })
+            .collect();
+        assert_eq!(boxes.len(), 3);
+        super::spread_labels(&mut boxes, opts.label_margin_x);
+        for (i, a) in boxes.iter().enumerate() {
+            for b in &boxes[i + 1..] {
+                assert!(!super::overlap(*a, *b), "{:?} covers {:?}", a, b);
+            }
+        }
+        // Each label stays on its window's title bar row.
+        let mut xs: Vec<i32> = boxes.iter().map(|b| b.0).collect();
+        xs.sort();
+        assert_eq!(xs, vec![6, 6 + 40 + 4, 1926]);
+    }
+
+    // Labels apart from each other stay where they are; one is moved past
+    // every label it would cover, also one it reaches only after a move.
+    #[test]
+    fn spread_moves_only_covering_labels() {
+        let mut boxes = vec![
+            (0, 0, 40, 60),
+            (60, 0, 40, 60),
+            (0, 25, 40, 60),
+            (500, 25, 40, 60),
+        ];
+        super::spread_labels(&mut boxes, 4);
+        assert_eq!(
+            boxes,
+            vec![
+                (0, 0, 40, 60),
+                (60, 0, 40, 60),
+                (104, 25, 40, 60),
+                (500, 25, 40, 60)
+            ]
+        );
+    }
+
+    // Without a title bar sway reports a zero deco_rect.
+    #[test]
+    fn labels_without_title_bars() {
+        let ws = parse(include_str!("../tests/fixtures/no-titlebar-workspace.json"));
+        assert_eq!(label_xs(&ws), vec![6, 6, 1030]);
+    }
+}
