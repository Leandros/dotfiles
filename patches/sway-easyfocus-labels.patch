+// sway reports deco_rect relative to the parent container (to the workspace
+// for its direct children and for floating windows), while rect is absolute.
+// Makes deco_rect.x absolute. Without a title bar deco_rect is all zero and
+// stays so.
+fn make_title_bar_x_absolute(child: &mut Node, parent: &Node) {
+    if child.deco_rect.height > 0 {
+        child.deco_rect.x += parent.rect.x;
+    }
+}
+
+// The x where a window's label starts: on its title bar, or at the left of
+// the window without one.
+fn title_x(window: &Node) -> i32 {
+    if window.deco_rect.height > 0 {
+        window.deco_rect.x
+    } else {
+        window.rect.x
+    }
+}
+
+// The right end of the title bar of `title_x`.
+fn title_end(window: &Node) -> i32 {
+    if window.deco_rect.height > 0 {
+        window.deco_rect.x + window.deco_rect.width
+    } else {
+        window.rect.x + window.rect.width
+    }
+}
+
+// Windows in a container that is a tab (or a stacked entry) have title bars
+// of their own at the left of the tabbed container, one row below the tab
+// bar, under the labels of the tabs to the left. Their labels start at
+// their tab instead, where that is still on their title bar.
+fn start_label_at_tab(window: &mut Node, tab_x: i32) {
+    if title_x(window) < tab_x && tab_x < title_end(window) {
+        window.deco_rect.x = tab_x;
+    }
+}
+
+// The windows of a workspace. Their deco_rect.x is where their label starts
+// (calculate_geometry): absolute, and at their tab where they are nested in
+// one.
 pub fn get_all_windows(workspace: &Node) -> Vec<Node> {
     let mut nodes = Vec::new();
     let mut q = VecDeque::new();
 
-    q.push_back(workspace.clone());
-    while let Some(node) = q.pop_back() {
+    // Each node with the x of the tab it is nested in, if any.
+    q.push_back((workspace.clone(), i32::MIN));
+    while let Some((mut node, tab_x)) = q.pop_back() {
         // if we have a window
         if (node.node_type == NodeType::Con || node.node_type == NodeType::FloatingCon)
             && node.nodes.is_empty()
         {
+            if node.deco_rect.height == 0 {
+                node.deco_rect.x = node.rect.x;
+            }
+            start_label_at_tab(&mut node, tab_x);
             nodes.push(node.clone());
         }
 
+        let tabbed = node.node_type == NodeType::Con
+            && matches!(node.layout, NodeLayout::Tabbed | NodeLayout::Stacked);
+
         // tiled/tabbed/stacked nodes
         for child in &node.nodes {
             let mut c = child.clone();
+            make_title_bar_x_absolute(&mut c, &node);
+            let child_tab_x = if tabbed && !c.nodes.is_empty() {
+                title_x(&c)
+            } else {
+                tab_x
+            };
             // a bit of a hack to keep track of stacked/tabbed layouts:
             // if we're stacked, we set our childrens' layouts to stacked and change the decorator
             // height.
@@ -59,12 +115,14 @@ pub fn get_all_windows(workspace: &Node) -> Vec<Node> {
                 // the stacked container.
                 c.deco_rect.height *= node.nodes.len() as i32;
             }
-            q.push_back(c);
+            q.push_back((c, child_tab_x));
         }
 
         // floating nodes
         for child in &node.floating_nodes {
-            q.push_back(child.clone());
+            let mut c = child.clone();
+            make_title_bar_x_absolute(&mut c, &node);
+            q.push_back((c, i32::MIN));
         }
     }
 
