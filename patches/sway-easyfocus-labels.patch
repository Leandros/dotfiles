+// Label boxes (x, y, width, height). Labels are taller than a title bar,
+// so a label one row below another (a window in a tab, under the tab bar)
+// covers it: moves each label right past the ones above and left of it
+// that it would cover, `gap` apart.
+fn spread_labels(boxes: &mut [(i32, i32, i32, i32)], gap: i32) {
+    let mut order: Vec<usize> = (0..boxes.len()).collect();
+    order.sort_by_key(|&i| (boxes[i].1, boxes[i].0));
+    for (n, &i) in order.iter().enumerate() {
+        let mut b = boxes[i];
+        // x only grows, so this ends.
+        while let Some(o) = order[..n]
+            .iter()
+            .map(|&j| boxes[j])
+            .find(|&o| overlap(b, o))
+        {
+            b.0 = o.0 + o.2 + gap;
+        }
+        boxes[i] = b;
+    }
+}
+
+fn overlap(a: (i32, i32, i32, i32), b: (i32, i32, i32, i32)) -> bool {
+    a.0 < b.0 + b.2 && b.0 < a.0 + a.2 && a.1 < b.1 + b.3 && b.1 < a.1 + a.3
+}
