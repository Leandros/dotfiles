 }
+
+#[cfg(test)]
+mod tests {
+    use figment::{
+        Figment,
+        providers::{Format, Yaml},
+    };
+
+    use super::calculate_geometry;
+    use crate::{options::Options, sway};
+
+    // A workspace as `swaymsg -t get_tree` prints it (JSON is YAML too).
+    fn parse(json: &str) -> swayipc::Node {
+        Figment::from(Yaml::string(json))
+            .extract()
+            .expect("valid tree")
+    }
+
+    // The label x of each window, relative to the workspace's output
+    // (the workspace stands in for the output; both start at x = 0).
+    fn label_xs(workspace: &swayipc::Node) -> Vec<i32> {
+        let opts = Options::default();
+        let mut xs: Vec<i32> = sway::get_all_windows(workspace)
+            .iter()
+            .map(|w| calculate_geometry(w, workspace, &opts).0)
+            .collect();
+        xs.sort();
+        xs
+    }
+
+    // splith: [splitv: [A, B], C]. C is a direct child of the workspace,
+    // so sway reports its deco_rect.x (1024) relative to the workspace,
+    // like its rect.x (1024): the label must not land at 2048 + margin,
+    // off a 2048 px wide output.
+    #[test]
+    fn split_labels_stay_on_their_windows() {
+        let ws = parse(include_str!("../tests/fixtures/split-workspace.json"));
+        // rect.x + window_rect.x (border 2) + label_margin_x (4).
+        assert_eq!(label_xs(&ws), vec![6, 6, 1030]);
+    }
+
+    // Tabbed: both children share the parent's rect; deco_rect.x is the
+    // tab offset, which the label needs.
+    #[test]
+    fn tabbed_labels_follow_their_tabs() {
+        let ws = parse(include_str!("../tests/fixtures/tabbed-workspace.json"));
+        assert_eq!(label_xs(&ws), vec![6, 1030]);
+    }
+
+    // Without a title bar sway reports a zero deco_rect.
+    #[test]
+    fn labels_without_title_bars() {
+        let ws = parse(include_str!("../tests/fixtures/no-titlebar-workspace.json"));
+        assert_eq!(label_xs(&ws), vec![6, 6, 1030]);
+    }
+}
