#!/bin/sh

# Xft.dpi and font settings; i3 (pango) and wezterm read them from here.
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources

# Disable bell
xset -b

# Custom Media keys
xbindkeys -p

# Key Repeat: xset r rate <delay before repeat> <repeat rate>
# May require to install xset (sudo dnf install xset)
xset r rate 200 50

# Kill X with Ctrl+Alt+Backspace
setxkbmap -option terminate:ctrl_alt_bksp

# This will use the built-in bone2 layout.
# setxkbmap de bone

# This will use our custom bone2 layout; kb also records it for the status bar.
~/bin/kb bone2 2>/dev/null || { setxkbmap de; xmodmap ~/.Xmodmap; }
